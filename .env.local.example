# Supabase 프로젝트 설정 > API 메뉴에서 확인할 수 있습니다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# /admin 페이지 로그인 비밀번호. 실제 값은 여기(예시 파일)에 적지 말고
# .env.local과 Vercel 프로젝트 환경변수에만 설정하세요.
ADMIN_PASSWORD=change-me

# 넥슨 Open API 키(숨은 스펙업 서버 조회용). openapi.nexon.com 에서 발급, 서버에서만 씀.
NEXON_API_KEY=your-nexon-api-key

# 썬데이 자동 갱신 Cron(/api/cron/sunday) 인증값. 아무 긴 무작위 문자열, Vercel 이 Cron 요청에 자동으로 붙여 보냄.
CRON_SECRET=your-random-secret

# Supabase 서버 전용 키(service role). 썬데이 Cron 이 sunday_weeks 표에 쓸 때만 씀. 모든 보안 규칙을 건너뛰므로
# 절대 클라이언트 코드 · 저장소에 넣지 말고 .env.local 과 Vercel(Sensitive)에만 두세요.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 썬데이 공지 이미지 글자 읽기: 네이버 클라우드 CLOVA OCR (General 도메인, 월 100회 무료). 서버에서만 사용.
# URL 은 도메인의 API Gateway 연동에서 나오는 APIGW Invoke URL (https://....apigw.ntruss.com/...).
CLOVA_OCR_URL=https://your-id.apigw.ntruss.com/custom/v1/0000/your-path
CLOVA_OCR_SECRET=your-clova-ocr-secret
